# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (fresh V2 project — see master plan §12)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings (migrations / direct SQL).
# INVARIANT: these MUST target the SAME project ref as NEXT_PUBLIC_SUPABASE_URL.
# `npm run db:push` reads POSTGRES_URL_NON_POOLING and is guarded by
# `npm run check:db-target` (scripts/lib/db-target.mjs) — it FAILS CLOSED if the
# ref doesn't match the app project. Use the Session pooler string from
# Supabase Dashboard → Project Settings → Database → Connect:
#   non-pooling/direct (migrations): port 5432, user postgres.<ref>
#   pooled (app/Prisma):             port 6543
# NEVER point these at the V1 project (xzwsdwllmrnrgbltibxt) or any other ref.
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
POSTGRES_PRISMA_URL=

# Encryption key for OAuth tokens at rest (32 bytes base64). DO NOT reuse the V1 key.
TOKEN_ENCRYPTION_KEY=

# HMAC key for signed OAuth state tokens (32 bytes base64). Distinct from TOKEN_ENCRYPTION_KEY.
OAUTH_STATE_SIGNING_KEY=

# Server-only pepper for purpose-bound sensitive-action challenges — today, the
# universal account-deletion verification code (ACCOUNT-DELETION-UNIVERSAL-VERIFICATION-1).
# The six-digit code is NEVER stored; only HMAC-SHA256(this key, purpose:user:challenge:code)
# is. A six-digit code has ~20 bits of entropy, so a plain unsalted hash would be
# brute-forceable from a database leak — this key (which never touches the database) is what
# makes the stored digest safe. REQUIRED IN PRODUCTION: when it is missing the deletion
# challenge routes fail CLOSED with a typed 503 rather than downgrading to an unkeyed digest,
# which means self-serve account deletion stops working until it is set. Server-only: never
# exposed to a client bundle, never logged. Rotating it invalidates outstanding codes (users
# simply request a new one). 32 bytes base64.
SENSITIVE_ACTION_CHALLENGE_KEY=

# HMAC key for the anonymous AI-planning limit cookie (REACT-LIVE-SKELETON-3). Signs the day-bucketed
# per-browser cap cookie on the public /api/ai/anonymous-workflow-guidance route so the count can't be
# forged. REQUIRED IN PRODUCTION: if neither this nor the OAUTH_STATE_SIGNING_KEY fallback below is set,
# anonymous AI planning fails closed (typed unavailable + sign-up CTA) rather than emit an unsigned
# (forgeable) cap. Falls back to OAUTH_STATE_SIGNING_KEY when blank (same HMAC key class; the cookie
# carries no secret). Set this OR keep OAUTH_STATE_SIGNING_KEY populated on Vercel. Dev/test may leave
# both blank (unsigned cookie — non-prod only). 32 bytes base64.
ANON_AI_LIMIT_SIGNING_KEY=

# Platform billing — ChainReact's OWN Stripe account (CS-2+). Separate from the
# WORKFLOW Stripe provider (STRIPE_CLIENT_ID / STRIPE_CLIENT_SECRET). Server-only.
# Billing is LIVE by default (no feature flag): if these are blank the billing routes
# fail closed with a typed 503 (PLATFORM_BILLING_NOT_CONFIGURED / PRICE_NOT_CONFIGURED).
STRIPE_SECRET_KEY=
# Signing secret for the PLATFORM billing webhook (POST /api/webhooks/stripe-billing).
# Distinct from the workflow provider's per-trigger endpoint secrets. Fail-closed if unset.
STRIPE_BILLING_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price ids per paid plan tier + billing interval (CS-2 + PRICING-INTERVAL-1). free =
# no charge, enterprise = custom/contact-sales — neither has a fixed price id. Set the monthly
# AND annual Price id for each paid tier. Checkout defaults to monthly when no interval is sent.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
# DEPRECATED single-interval vars — honored ONLY as a MONTHLY fallback for backward compat.
# Prefer the _MONTHLY/_ANNUAL vars above; these will be removed once envs are migrated.
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=
# STRIPE_PRICE_BUSINESS=
# Free-trial length in DAYS for Pro & Team (PRO-TEAM-TRIAL-ENFORCEMENT-1). DARK BY DEFAULT:
# blank/unset/<=0 = NO trial is offered or claimed (the whole trial system is inert). Set to the
# owner-approved length (14) to go live — this is the single trial go-live switch. Only Pro & Team
# ever receive a trial; Business/Enterprise/Free never do. Each account gets one trial total,
# enforced by an atomic DB claim keyed on account_id. Before setting this live, configure Stripe so
# checkout collects a payment method during the trial (Checkout subscription mode does by default).
PLATFORM_TRIAL_PERIOD_DAYS=

# AI model adapters (Phase 4 AI track). OPTIONAL — leave blank until the AI
# planner is exposed via routes/UI. When ANTHROPIC_API_KEY is set, the runtime
# model client (services/ai/modelClients, Slice 4.AI-8C) uses the Anthropic
# adapter for the default models in core/ai/models.ts; when unset the planner
# fails safe (NOT_CONFIGURED). OPENAI_API_KEY is reserved (no adapter yet).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Slack (Slice 1 vertical slice)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Gmail / Google OAuth (Slice 2c vertical slice). Use developer creds for
# now; an org-owned Google Cloud project + OAuth consent setup lands
# before production readiness.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E2e mocking only — leave unset in production. Defaults point at real Google.
# GOOGLE_AUTHORIZE_BASE=
# GOOGLE_TOKEN_BASE=
# GMAIL_API_BASE=
# GOOGLE_CALENDAR_API_BASE=
# GOOGLE_USERINFO_BASE=
# Google Analytics (GA4 — Slice 3.GOOGLE-ANALYTICS) reuses GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET above (no GA-specific OAuth creds). The analytics.edit
# scope is a Google sensitive scope — public launch needs OAuth app
# verification (an internal launch-readiness gate, not user-facing). The
# bases below are E2e-only overrides; defaults point at the real GA4 hosts.
# GOOGLE_ANALYTICS_DATA_API_BASE=
# GOOGLE_ANALYTICS_ADMIN_API_BASE=
# GOOGLE_ANALYTICS_MP_BASE=

# Watch-channel HMAC key (Slice 3 — Google Calendar push trigger). Signs
# the X-Goog-Channel-Token Calendar echoes back to /api/webhooks/google-calendar
# so the receive route can detect spoofed channelIds. 32 bytes base64. Required
# for Calendar Slice 3 production; the e2e harness substitutes a fixed throwaway
# value when this is unset.
WATCH_CHANNEL_SECRET=

# Monday.com OAuth + webhooks (Slice 3.MONDAY).
# CLIENT_ID / CLIENT_SECRET come from the Monday Developer App. Webhook
# triggers (MONDAY-7) require MONDAY_SIGNING_SECRET — the receive route
# verifies the x-monday-signature HMAC-SHA256 over the raw body and
# FAILS CLOSED (503) when this is unset. Obtain it from the Monday
# Developer App dashboard.
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_SIGNING_SECRET=
# E2e mocking only — leave unset in production (defaults point at real Monday).
# MONDAY_AUTHORIZE_BASE=
# MONDAY_TOKEN_BASE=
# MONDAY_API_BASE=
# MONDAY_WEBHOOK_URL=

# Dropbox OAuth + webhook (Slice 3.DROPBOX).
# CLIENT_ID / CLIENT_SECRET come from the Dropbox App Console. The
# `dropbox:new_file` trigger (DROPBOX-5) is an APP-LEVEL webhook: register
# the URL ONCE in the App Console (App → Webhooks →
#   ${NEXT_PUBLIC_APP_URL}/api/webhooks/dropbox
# ), which Dropbox verifies with a GET ?challenge= echo. Inbound POST
# notifications are HMAC-SHA256 signed with the Dropbox APP SECRET, so
# DROPBOX_CLIENT_SECRET doubles as the webhook signing key — the receive
# route verifies X-Dropbox-Signature over the raw body and FAILS CLOSED
# (503) when it is unset (no separate DROPBOX_WEBHOOK_SECRET).
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# E2e mocking only — leave unset in production (defaults point at real Dropbox).
# DROPBOX_API_BASE=
# DROPBOX_CONTENT_BASE=

# Facebook (Pages) OAuth (Slice 3.FACEBOOK).
# CLIENT_ID / CLIENT_SECRET come from the Meta App Dashboard. Facebook
# issues a long-lived user token (~60 days, NO refresh token); Page access
# tokens are derived at runtime. The Pages scopes (pages_manage_posts,
# pages_messaging, read_insights, …) require Meta ADVANCED ACCESS (App
# Review) for EXTERNAL users — but Development Mode grants the app's own
# admins/developers/testers Standard Access without review, so the runtime
# is usable day one. CLIENT_SECRET also signs the X-Hub-Signature-256 on
# the FACEBOOK-5 webhook (no separate webhook secret).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# FACEBOOK-5 Page webhook (new_post / new_comment). Operator setup:
#   1. Set FACEBOOK_WEBHOOK_VERIFY_TOKEN to any random string and enter the
#      SAME value in the Meta App Dashboard -> Webhooks -> Verify Token.
#   2. Set the App Dashboard webhook callback URL to:
#        ${NEXT_PUBLIC_APP_URL}/api/webhooks/facebook
#      and subscribe the `page` object's `feed` field.
# The GET handshake echoes hub.challenge only when hub.verify_token matches
# this value; POST notifications are verified via X-Hub-Signature-256 keyed
# with FACEBOOK_CLIENT_SECRET above.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# E2e mocking only — leave unset in production (defaults point at real Facebook).
# FACEBOOK_AUTHORIZE_BASE=
# FACEBOOK_GRAPH_BASE=
# FACEBOOK_GRAPH_VERSION=

# Cloudflare Turnstile bot protection (SEC-3). Guards the public auth surfaces
# (sign-up, sign-in, password reset). Verification is SUPABASE-NATIVE: the widget
# produces a token that is forwarded to Supabase Auth (`captchaToken`), and
# Supabase verifies it against the Turnstile SECRET configured in the Supabase
# dashboard (Authentication → Bot & Abuse Protection → Turnstile). The app does
# NOT read the secret and does NOT call siteverify itself (a Turnstile token is
# single-use — redeeming it app-side would make Supabase reject the request).
#
# So the app only needs the PUBLIC site key below. When it's blank the widget is
# hidden and no token is sent (correct for local/dev, where Supabase captcha is
# off). PRODUCTION: set this site key AND enable Turnstile (with the matching
# secret) in the Supabase dashboard — both must be on together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY is configured in the Supabase dashboard, NOT here — the app
# never reads it. (Left as a reminder of where the secret lives.)

# ChainReact AI provider — runtime AI actions (AI-PROVIDER arc; carried since CS-2,
# documented in CS-9). ALL OFF/blank by default; the AI provider is invisible and
# inert until enabled.
#
# ROLLOUT ORDER (plan risk R2, enforced as a report by
# describeAiProcessorRolloutReadiness(), services/ai/processor/config.ts):
# in production, turn ENABLE_AI_CREDIT_ENFORCEMENT on BEFORE AI_PROCESSOR_ENABLED —
# scheduled workflows run unattended, so an enabled processor without credit
# enforcement is unmetered spend. Also apply the ai_cost_events feature CHECK
# migration (20260728000000) before enabling.
#
# Master flag. Unset/anything-but-"true" = OFF: no AI catalog, no picker section,
# every AI step refuses before any read, charge, or network call.
AI_PROCESSOR_ENABLED=
# "gateway" (default; Render-hosted Hermes gateway) | "first_party" (direct vendor
# clients via services/ai/modelClients — needs those flags/keys separately).
AI_PROCESSOR_PROVIDER=
# Request timeout in ms (default 60000, clamped 5000-120000).
AI_PROCESSOR_TIMEOUT_MS=
# Document/input text budget in characters (default 150000). Extract modes FAIL
# over budget (never silently truncate); summarize/classify/answer truncate with a flag.
AI_PROCESSOR_MAX_INPUT_CHARS=
# Shared with the Hermes guidance path (same Render service): base URL + bearer
# token for the ChainReact AI gateway. Token is header-only — never logged, never
# serialized into request bodies (test-asserted).
CHAINREACT_AI_GATEWAY_URL=
CHAINREACT_AI_GATEWAY_TOKEN=
# AI credit enforcement (services/billing/aiCreditGate.ts). OFF = recording-only:
# ai_cost_events rows are written but nothing is deducted or refused. Must be ON
# in production before AI_PROCESSOR_ENABLED (see rollout order above).
ENABLE_AI_CREDIT_ENFORCEMENT=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# System email (TEAM-INVITATION-EMAIL-1) — ChainReact's OWN transactional email
# (team invitations), sent via Resend (services/email/). NOT the workflow
# Gmail/Outlook actions. BOTH must be set or the transport reports
# "not_configured" and the UI falls back to the copyable invite link (the
# invitation itself is always created either way). TRANSACTIONAL_EMAIL_FROM must
# be a sender on a domain verified in the Resend dashboard, e.g.
# "ChainReact <invites@chainreact.app>". Emailed links are built from
# NEXT_PUBLIC_APP_URL (above), never from request headers.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=

# Dual Builder — Document surface (DOC-FINAL-ACCEPTANCE-1). Default OFF: unset/empty
# hides the Document/Visual toggle entirely. Set to "true" to enable it.
ENABLE_DOCUMENT_BUILDER=

# ─── Environment model (SUPABASE-ENV-PIPELINE-1) ─────────────────────────────
# Three database environments; each command must declare its target explicitly.
#   local        — Docker stack (`npm run supabase:test:start`), loopback only.
#                  Credentials are generated into .env.test.local automatically.
#   development  — hosted `chainreact-dev` Supabase project. Guarded commands:
#                  `db:push:dev`, `dev:reset`, `dev:bootstrap`. All three refuse
#                  to run without CHAINREACT_DB_TARGET=development AND a dev
#                  project ref that is NOT the production ref (denylisted in
#                  scripts/lib/env-target.mjs).
#   production   — the live project. ONLY the promote-production GitHub workflow
#                  (manual approval) applies migrations there. The dev commands
#                  above can never target it.
# Runbook: docs/runbooks/supabase-environments.md
#
# Development-project values live in .env.development.local (gitignored) or CI
# secrets — NEVER in this file and NEVER with real values committed:
# CHAINREACT_DB_TARGET=            # local | development — set per command, no default
# SUPABASE_DEV_PROJECT_REF=        # 20-char ref of chainreact-dev
# SUPABASE_DEV_URL=                # https://<dev-ref>.supabase.co
# SUPABASE_DEV_DB_URL=             # session-pooler Postgres URL for the dev project
# SUPABASE_DEV_SERVICE_ROLE_KEY=   # dev project service-role key (server-side only)
# DEV_RESET_CONFIRM=               # must equal SUPABASE_DEV_PROJECT_REF for dev:reset
# DEV_BOOTSTRAP_PASSWORD=          # ≥12 chars; shared password for synthetic dev users

# Bearer secret protecting all 11 /api/cron/* routes (vercel.json). Vercel sends
# it automatically as `Authorization: Bearer <CRON_SECRET>` for scheduled ticks;
# without it every cron route returns 500 (services/cron/auth.ts). Use different
# values per environment.
CRON_SECRET=
