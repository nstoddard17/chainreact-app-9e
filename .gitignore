# MCP Stage-2A — runtime-produced sanitized smoke artifact (read by the internal
# MCP diagnostics tools). The generated option-source manifest under
# scripts/mcp/data/ is COMMITTED (drift-checked) and is NOT ignored.
artifacts/

# next.js
.next
# Next build output under a custom distDir. Parallel/e2e runs build into their own
# directory (e.g. `.next-analytics-e2e`) so they don't corrupt the running dev
# server's `.next`; plain `.next` does not match those. Scoped to the `.next-`
# prefix so it covers only Next build output, nothing else. (RESPONSIVE-MARKETING-9)
.next-*/
out
next-env.d.ts

