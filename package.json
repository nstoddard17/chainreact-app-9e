{
  "name": "chainreact-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:structure": "node scripts/check-leaf-folder-counts.mjs",
    "lint:migrations": "node scripts/check-migration-rls.mjs",
    "verify:responsive": "node scripts/responsive/verify.mjs",
    "check:db-target": "node scripts/check-db-target.mjs",
    "verify:reserve-reconcile": "node scripts/verify-reserve-reconcile-rpcs.mjs",
    "verify:shadow-comparisons": "node scripts/verify-billing-shadow-comparisons.mjs",
    "review:shadow-comparisons": "node scripts/review-reserve-reconcile-shadow-data.mjs",
    "sweep:stale-runs": "node scripts/sweep-stale-workflow-runs.mjs",
    "account:internal": "node scripts/mark-account-internal.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:push:dev": "node scripts/db-push-dev.mjs",
    "dev:reset": "node scripts/dev-reset.mjs",
    "dev:bootstrap": "node scripts/dev-bootstrap.mjs",
    "db:types": "node scripts/db-types.mjs gen",
    "db:types:check": "node scripts/db-types.mjs check",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "mobile-contracts:build": "node -e \"require('node:fs').rmSync('packages/mobile-contracts/dist',{recursive:true,force:true})\" && tsc -p packages/mobile-contracts/tsconfig.json",
    "mobile-contracts:pack": "npm run mobile-contracts:build && npm pack ./packages/mobile-contracts --pack-destination packages/mobile-contracts",
    "mobile-contracts:pack:check": "npm run mobile-contracts:build && node scripts/check-mobile-contracts-pack.mjs",
    "mcp:build": "tsc -p scripts/mcp/tsconfig.json",
    "mcp:start": "node scripts/mcp/dist/server.js",
    "mcp:smoke": "npm run mcp:build && node scripts/mcp/smoke.mjs",
    "mcp:http": "node scripts/mcp/dist/httpServer.js",
    "mcp:http:smoke": "npm run mcp:build && node scripts/mcp/http-smoke.mjs",
    "mcp:import": "node --experimental-strip-types --import ./scripts/mcp-import/register-alias.mjs scripts/mcp-import/cli.ts",
    "chainreact:build": "node -e \"require('node:fs').rmSync('scripts/chainreact/dist',{recursive:true,force:true})\" && tsc -p scripts/chainreact/tsconfig.json",
    "chainreact": "npm run chainreact:build && node scripts/chainreact/dist/cli.js",
    "test:e2e": "playwright test",
    "supabase:test:start": "node scripts/supabase-test.mjs start",
    "supabase:test:stop": "node scripts/supabase-test.mjs stop",
    "supabase:test:reset": "node scripts/supabase-test.mjs reset",
    "supabase:test:status": "node scripts/supabase-test.mjs status",
    "e2e:dual-builder": "node scripts/run-e2e-dual-builder.mjs on",
    "e2e:dual-builder:flag-off": "node scripts/run-e2e-dual-builder.mjs off",
    "smoke:prod": "playwright test --config=playwright.smoke.config.ts",
    "smoke:actions": "npm run chainreact -- smoke actions",
    "smoke:actions:run": "jest tests/integration/smoke-actions tests/unit/smoke-actions",
    "smoke:actions:run:workflow": "jest tests/integration/smoke-actions/run-all.workflow.dev.test.ts",
    "smoke:actions:run:workflow:live": "jest tests/integration/smoke-actions/run-all.workflow-live.dev.test.ts",
    "smoke:writes:live": "jest tests/integration/smoke-actions/run-writes.workflow-live.dev.test.ts",
    "smoke:triggers:scheduled": "jest tests/integration/trigger-smoke/scheduled.workflow.dev.test.ts",
    "smoke:triggers:excel": "jest tests/integration/trigger-smoke/excel-polling.workflow-live.dev.test.ts",
    "smoke:triggers:onenote": "jest tests/integration/trigger-smoke/onenote-polling.workflow-live.dev.test.ts",
    "smoke:triggers:gmail": "jest tests/integration/trigger-smoke/gmail-polling.workflow-live.dev.test.ts",
    "smoke:triggers:mailchimp": "jest tests/integration/trigger-smoke/mailchimp-polling.workflow-live.dev.test.ts",
    "smoke:triggers:microsoft": "jest tests/integration/trigger-smoke/microsoft-graph-webhook.workflow-live.dev.test.ts",
    "smoke:triggers:google": "jest tests/integration/trigger-smoke/google-watch-webhook.workflow-live.dev.test.ts",
    "smoke:triggers:dropbox": "jest tests/integration/trigger-smoke/dropbox-webhook.workflow-live.dev.test.ts",
    "smoke:triggers:facebook": "jest tests/integration/trigger-smoke/facebook-webhook.workflow-live.dev.test.ts",
    "smoke:triggers:webhook": "jest tests/integration/trigger-smoke/slack-webhook.workflow.dev.test.ts tests/integration/trigger-smoke/github-webhook.workflow.dev.test.ts tests/integration/trigger-smoke/trello-webhook.workflow.dev.test.ts tests/integration/trigger-smoke/monday-webhook.workflow.dev.test.ts tests/integration/trigger-smoke/asana-webhook.workflow.dev.test.ts tests/integration/trigger-smoke/typeform-webhook.workflow.dev.test.ts tests/integration/trigger-smoke/calendly-webhook.workflow.dev.test.ts tests/integration/trigger-smoke/consolidated-webhook.workflow.dev.test.ts",
    "smoke:ops-alerts": "jest tests/integration/observability/ops-alerts.evaluator.dev.test.ts",
    "typecheck": "tsc --noEmit",
    "certify:billing": "node scripts/certify-billing-lifecycle.mjs",
    "test:analytics:layout": "playwright test --config=playwright.analytics.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.0",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.5.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.12.5",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.0",
    "next": "^15.1.0",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "unpdf": "^1.6.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^15.1.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
